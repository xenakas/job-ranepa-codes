{start <- Sys.time()
set.seed(123)
I=50
n=30
time=matrix(NA,ncol=3,nrow=I)
for(i in 1:I){
t0<-proc.time()
x<-solve(matrix(runif(n^2),n))
mt1<-proc.time()
time[i,]<-(mt1-t0)[1:3]
}
end1 <- Sys.time()
end1-start}
